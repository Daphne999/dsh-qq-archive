{
  "name": "dsh-qq-archive",
  "version": "0.1.1",
  "description": "Local searchable archive of DSH chat history: decodes the multi-frame zstd session logs, extracts user/assistant messages into SQLite, and exposes search/stats tools. | 把会话日志归档成本地可检索的聊天库（多帧 zstd 逐帧解码 + SQLite）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daphne999/dsh-qq-archive.git"
  },
  "bugs": {
    "url": "https://github.com/Daphne999/dsh-qq-archive/issues"
  },
  "homepage": "https://github.com/Daphne999/dsh-qq-archive#readme",
  "author": "Daphne999",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "archive",
    "sqlite",
    "memory",
    "session-log",
    "zstd"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
